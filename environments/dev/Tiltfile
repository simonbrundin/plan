# ==================================================================
# Plan Development Environment - Kubernetes
# ==================================================================
# Användning:
#   tilt up          # Starta
#   tilt down       # Stoppa
# ==================================================================

version_settings(constraint='>=0.22.2')

allow_k8s_contexts('teleport.simonbrundin.com-cluster1')

namespace = k8s_namespace()

print('==========================================')
print('Kubernetes Development Mode')
print('Namespace: ' + namespace)
print('==========================================')

default_registry('ttl.sh/' + namespace)

# Frontend (Nuxt)
docker_build(
    'plan-frontend',
    context='../../src/nuxt',
    dockerfile='../../src/nuxt/Dockerfile.dev',
    only=[
        'app', 'server', 'pages', 'components', 'composables', 'utils',
        'nuxt.config.ts', 'package.json', 'bun.lock', 'bun.lockb',
    ],
    live_update=[
        fall_back_on('../../src/nuxt/nuxt.config.ts'),
        fall_back_on('../../src/nuxt/package.json'),
        sync('../../src/nuxt/app', '/app/app'),
        sync('../../src/nuxt/server', '/app/server'),
        sync('../../src/nuxt/pages', '/app/pages'),
        sync('../../src/nuxt/components', '/app/components'),
        sync('../../src/nuxt/composables', '/app/composables'),
        sync('../../src/nuxt/utils', '/app/utils'),
        run('bun install', trigger=['../../src/nuxt/package.json', '../../src/nuxt/bun.lock']),
    ],
)

# API (Go)
docker_build(
    'plan-api',
    context='../../src/api',
    dockerfile='../../src/api/Dockerfile.dev',
    live_update=[
        fall_back_on('../../src/api/go.mod'),
        sync('../../src/api/internal', '/app/internal'),
        sync('../../src/api/cmd', '/app/cmd'),
    ],
)

# Kubernetes Resources
k8s_yaml(kustomize('./kubernetes/overlays/dev'))

k8s_resource(workload='frontend', new_name='Nuxt Dev Server', port_forwards=3000, labels=['Frontend'])
k8s_resource(workload='api', new_name='Go API', port_forwards=8080, labels=['API'])
k8s_resource(workload='plan-dev-db', new_name='PostgreSQL', port_forwards=5432, labels=['Database'])
k8s_resource(workload='pgview', new_name='pgview', port_forwards=5051, labels=['Database'])

frontend_url = namespace + '.simonbrundin.com'

if config.tilt_subcommand == 'up':
    print("""
\033[32mKubernetes Development Mode\033[0m
Namespace: {namespace}

Access:
  Frontend: http://{frontend}
  pgview:   http://localhost:5051

Database:
  Host:     plan-dev-db-rw (in-cluster)
  User:     plan
  Password: plan
  Database: plan
    """.format(namespace=namespace, frontend=frontend_url))
